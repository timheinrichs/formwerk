<?xml version="1.0"?>
<ruleset name="Formwerk">
	<description>WordPress coding standards, adapted for PSR-4 class files.</description>

	<file>formwerk.php</file>
	<file>uninstall.php</file>
	<file>src</file>
	<file>tests</file>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>
	<arg name="parallel" value="8"/>

	<config name="minimum_wp_version" value="6.6"/>
	<config name="testVersion" value="8.1-"/>

	<rule ref="WordPress">
		<!-- PSR-4: file names follow the class name. -->
		<exclude name="WordPress.Files.FileName"/>
	</rule>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="formwerk"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="formwerk"/>
				<element value="Formwerk"/>
			</property>
		</properties>
	</rule>

	<!-- PHPMailer's public properties are not snake_case. -->
	<rule ref="WordPress.NamingConventions.ValidVariableName">
		<properties>
			<property name="allowed_custom_properties" type="array">
				<element value="Host"/>
				<element value="Port"/>
				<element value="SMTPSecure"/>
				<element value="SMTPAutoTLS"/>
				<element value="SMTPAuth"/>
				<element value="Username"/>
				<element value="Password"/>
				<element value="Timeout"/>
				<element value="From"/>
				<element value="Sender"/>
				<element value="SMTPDebug"/>
				<element value="Debugoutput"/>
			</property>
		</properties>
	</rule>

	<!-- Tests are plain PHPUnit: no doc blocks per test, no WordPress file-access rules. -->
	<rule ref="Squiz.Commenting">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="Generic.Commenting">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<!-- Test doubles mirror PHPMailer's naming. -->
	<rule ref="WordPress.NamingConventions.ValidVariableName">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.NamingConventions.ValidFunctionName">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<!-- Stand-ins for WordPress functions: global, unprefixed and incomplete on purpose. -->
	<exclude-pattern>tests/stubs.php</exclude-pattern>
</ruleset>
